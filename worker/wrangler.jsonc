{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "claude-code-telegram-bot",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-18",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "USERS",
